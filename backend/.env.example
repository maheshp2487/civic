# ==========================================
# InnoAi - Citizen-First Legal Navigation
# Backend Environment Configuration
# ==========================================

# 1. DEMO MODE
# Set to 'true' to run the offline hackathon demo corpus.
# Set to 'false' to enforce production Supabase connection.
DEMO_MODE=true

# 2. AI MODEL (REQUIRED IN ALL MODES)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=your_gemini_api_key_backup_here

# 3. PRODUCTION RETRIEVAL (REQUIRED IF DEMO_MODE=false)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# 4. TUNING
# Weights for Hybrid Search (Semantic, Keyword, Authority, Freshness)
WEIGHT_SEMANTIC=0.5
WEIGHT_KEYWORD=0.2
WEIGHT_AUTHORITY=0.2
WEIGHT_FRESHNESS=0.1
